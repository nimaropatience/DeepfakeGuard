if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Export PyTorch to ONNX")
    parser.add_argument("--checkpoint", required=True, help="Path to .pth/.pt file")
    parser.add_argument("--output", required=True, help="Output .onnx path")
    parser.add_argument("--type", default="hybrid", choices=["hybrid", "mesonet"])
    args = parser.parse_args()

    export_to_onnx(args.checkpoint, args.output, args.type)
